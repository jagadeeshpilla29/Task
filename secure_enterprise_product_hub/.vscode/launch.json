    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "secure_enterprise_product_hub",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define",
                "API_BASE_URL=http://localhost:8000"
            ]
        },
        {
            "name": "secure_enterprise_product_hub (Android emulator)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define",
                "API_BASE_URL=http://10.0.2.2:8000"
            ]
        },
        {
            "name": "secure_enterprise_product_hub (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "secure_enterprise_product_hub (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}
