    "version": "0.2.0",
    "configurations": [
        {
            "name": "Product Hub (Flutter - desktop/web)",
            "program": "lib/main.dart",
            "cwd": "secure_enterprise_product_hub",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define=API_BASE_URL=http://localhost:8000"
            ]
        },
        {
            "name": "Product Hub (Flutter - Android emulator)",
            "program": "lib/main.dart",
            "cwd": "secure_enterprise_product_hub",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define=API_BASE_URL=http://10.0.2.2:8000"
            ]
        }
    ]
}
